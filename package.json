{
  "name": "vantera",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "db:generate": "cd packages/db && drizzle-kit generate",
    "db:migrate": "cd packages/db && drizzle-kit migrate",
    "db:push": "dotenv-cli -e .env -- sh -c 'cd packages/db && pnpm exec drizzle-kit push:pg'",
    "db:studio": "dotenv-cli -e .env -- sh -c 'cd packages/db && pnpm exec drizzle-kit studio'",
    "db:apply": "dotenv -e .env -- tsx packages/db/scripts/apply-sql.ts",
    "db:verify": "dotenv -e .env -- tsx packages/db/scripts/verify-rls.ts",
    "db:list-tables": "dotenv -e .env -- tsx packages/db/scripts/list-tables.ts",
    "db:seed": "dotenv -e .env -- tsx packages/db/seed/index.ts",
    "db:seed:templates": "dotenv -e .env -- tsx packages/db/scripts/run-vertical-templates.ts",
    "trigger:dev": "dotenv -e .env -- trigger dev",
    "trigger:deploy": "dotenv -e .env -- trigger deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@trigger.dev/build": "^4.4.6",
    "@trigger.dev/sdk": "^4.4.6",
    "@types/node": "^20.19.41",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^14.2.35",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "trigger.dev": "^4.4.6",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.30.10"
    }
  }
}
