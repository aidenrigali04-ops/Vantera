# Database (Drizzle / Supabase Postgres)
DATABASE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# From Supabase: Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=

# App
# Base domain for tenant subdomains — {slug}.{NEXT_PUBLIC_APP_DOMAIN}
# Local dev (Safari-safe): lvh.me  →  http://{slug}.lvh.me:3000
# Local dev (Chrome only):  localhost  →  http://{slug}.localhost:3000
NEXT_PUBLIC_APP_DOMAIN=lvh.me
NEXT_PUBLIC_APP_URL=http://lvh.me:3000

# Integrations (configure when implemented)
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
ANTHROPIC_API_KEY=
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# Debug agent (optional — enables isolation/E2E tests)
# Override env file path for Larry / CLI tools (defaults: .env then apps/web/.env)
VANTERA_ENV_FILE=
INTERNAL_API_BASE_URL=
GITHUB_TOKEN=
GITHUB_REPO=
# Account UUID for Larry T3 API smoke tests (defaults to first active user if unset)
DEBUG_TEST_ACCOUNT_ID_TEAM=
DEBUG_TEST_ACCOUNT_ID_ENTERPRISE=
DEBUG_TEST_CONTACT_ID_A=
DEBUG_TEST_CONTACT_ID_B=
DEBUG_TEST_CONTACT_ID_OTHER_ACCOUNT=
DEBUG_TEST_PORTAL_DOMAIN=
DEBUG_MAX_FIX_ATTEMPTS=50
