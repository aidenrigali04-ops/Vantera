# ── MCP server keys (read from your shell env by .mcp.json) ──────────────
# Export these in your shell profile or load via direnv; .mcp.json expands
# ${VAR} from the environment Claude Code runs in, not from this file.

# Smartlead — app.smartlead.ai → Settings → API Keys (email-infra)
SMARTLEAD_API_KEY=
# Shared secret for inbound webhook verification (x-smartlead-secret header)
SMARTLEAD_WEBHOOK_SECRET=

# Unipile — dashboard → API keys (linkedin-infra)
UNIPILE_API_KEY=
UNIPILE_DSN=
# Shared secret for inbound webhook verification (x-unipile-secret header)
UNIPILE_WEBHOOK_SECRET=

# Explorium AgentSource — developers.explorium.ai (discovery + signals)
EXPLORIUM_API_KEY=

# Outbound voice (caller agent). Vendor key + inbound webhook secret + shared caller ID.
VOICE_API_KEY=
VOICE_WEBHOOK_SECRET=
VOICE_FROM_NUMBER=

# Stripe MCP needs no key here — it authenticates via OAuth on first connect.
# Playwright MCP needs no key.

# ── Platform env (copy to .env.local / .env, fill real values) ───────────

# App base URL. NEXT_PUBLIC_APP_URL is the browser-exposed copy (auth redirects);
# APP_URL is the server/Trigger-runtime copy (unsubscribe links, webhook callbacks).
# Keep both set to the same origin per environment. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Supabase (Auth + Postgres) — dev project "Vantera" (batyjchztbrqzkcvhkmk)
NEXT_PUBLIC_SUPABASE_URL=https://batyjchztbrqzkcvhkmk.supabase.co
# Publishable key — safe to expose to the browser (RLS is the access control)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Transaction-mode pooler (port 6543; createDb sets prepare:false for this).
# Password: Supabase dashboard → Project Settings → Database. Real value in .env.local only.
# Format: postgresql://postgres.batyjchztbrqzkcvhkmk:[PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Anthropic (constructed only inside @vantera/ai)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Voyage embeddings — powers the help copilot knowledge index (RAG)
VOYAGE_API_KEY=

# Service-role key (jobs only — bypasses RLS for the sanctioned deletion path).
# Server-side only: never NEXT_PUBLIC, never shipped to the browser.
SUPABASE_URL=https://batyjchztbrqzkcvhkmk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Trigger.dev v4 — cloud project "Vantera" (ref also baked into trigger.config.ts)
TRIGGER_PROJECT_REF=proj_jzndkpjvnrfgzgafavma
TRIGGER_SECRET_KEY=

# Billing (Stripe) — Phase 7
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_ADDON_SEAT=
STRIPE_PRICE_ADDON_LINKEDIN=

# Resend (transactional only — never cold outreach). Behind @vantera/transactional-email.
RESEND_API_KEY=
# Verified sender address on a Resend-verified domain, e.g. noreply@vanterasystem.com
RESEND_FROM_EMAIL=

# CRM push (Phase 9) — behind @vantera/crm-infra. Per-destination OAuth client credentials.
# When a destination's CLIENT_ID is set, Connect runs the real OAuth redirect; otherwise the
# adapter is stubbed and Connect stands up a local connection for the management UI.
# AES-256-GCM key (32-byte hex) for encrypting stored OAuth tokens; needed once token exchange lands.
CRM_TOKEN_KEY=
CRM_HUBSPOT_CLIENT_ID=
CRM_HUBSPOT_CLIENT_SECRET=
CRM_SALESFORCE_CLIENT_ID=
CRM_SALESFORCE_CLIENT_SECRET=
CRM_GOHIGHLEVEL_CLIENT_ID=
CRM_GOHIGHLEVEL_CLIENT_SECRET=
CRM_SLACK_CLIENT_ID=
CRM_SLACK_CLIENT_SECRET=
CRM_MONDAY_CLIENT_ID=
CRM_MONDAY_CLIENT_SECRET=
