# Database (Drizzle / Supabase Postgres)
DATABASE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# From Supabase: Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=

# App
# Base domain for tenant subdomains — {slug}.{NEXT_PUBLIC_APP_DOMAIN}
# Local dev (Safari-safe): lvh.me  →  http://{slug}.lvh.me:3000
# Local dev (Chrome only):  localhost  →  http://{slug}.localhost:3000
NEXT_PUBLIC_APP_DOMAIN=lvh.me
NEXT_PUBLIC_APP_URL=http://lvh.me:3000

# Integrations (configure when implemented)
# CRM connections use per-workspace tokens saved in Integrations (no env vars required):
# - HubSpot: private app access token (Settings → Integrations → Private Apps)
# - GoHighLevel: API key + Location ID (Sub-account → Settings → API)
# - Salesforce: instance URL + OAuth access token (Connected App)
RESEND_API_KEY=
# Resend webhook signing secret (Webhooks → Signing secret)
RESEND_WEBHOOK_SECRET=
# Subdomain with Resend inbound MX (default: inbound.{NEXT_PUBLIC_APP_DOMAIN})
OUTREACH_INBOUND_DOMAIN=
# Phase 2 — Apify lead discovery (Aspire / Prospect Scout)
APIFY_API_TOKEN=
# Optional override — defaults to code_crafter~leads-finder
APIFY_LEADS_ACTOR_ID=
# Leads per search run (1–100, default 50). Set 100 for maximum volume per Apify call.
ASPIRE_APIFY_FETCH_COUNT=50
# Legacy — no longer used by Aspire
APOLLO_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
ANTHROPIC_API_KEY=
# Trigger.dev — Vantera project only (create at cloud.trigger.dev, not legacy Ai Marketing Agents)
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# Debug agent (optional — enables isolation/E2E tests)
# Override env file path for Larry / CLI tools (defaults: .env then apps/web/.env)
VANTERA_ENV_FILE=
INTERNAL_API_BASE_URL=
GITHUB_TOKEN=
GITHUB_REPO=
# Account UUID for Larry T3 API smoke tests (defaults to first active user if unset)
DEBUG_TEST_ACCOUNT_ID_TEAM=
DEBUG_TEST_ACCOUNT_ID_ENTERPRISE=
DEBUG_TEST_CONTACT_ID_A=
DEBUG_TEST_CONTACT_ID_B=
DEBUG_TEST_CONTACT_ID_OTHER_ACCOUNT=
DEBUG_TEST_PORTAL_DOMAIN=
DEBUG_MAX_FIX_ATTEMPTS=50
