{
  "manifest_version": 3,
  "name": "Vantera LinkedIn Outreach",
  "description": "LinkedIn send queue for Vantera campaigns and SDR sequences.",
  "version": "1.0.0",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vantera LinkedIn"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
