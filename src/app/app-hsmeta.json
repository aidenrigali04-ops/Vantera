{
  "uid": "get_started_app",
  "type": "app",
  "config": {
    "description": "Vantera pushes closed-won deals into HubSpot and (opt-in) logs LinkedIn outreach, replies, and booked meetings as notes on the contact timeline.",
    "name": "Vantera",
    "distribution": "private",
    "auth": {
      "type": "oauth",
      "redirectUrls": [
        "https://www.vanterasystem.dev/api/crm/hubspot/callback",
        "https://vanterasystem.dev/api/crm/hubspot/callback",
        "http://localhost:3000/api/crm/hubspot/callback"
      ],
      "requiredScopes": [
        "oauth",
        "crm.objects.contacts.read",
        "crm.objects.contacts.write",
        "crm.objects.deals.write"
      ],
      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": ["https://api.hubapi.com"],
      "iframe": [],
      "img": []
    },
    "support": {
      "supportEmail": "aiden@vanterasystem.com",
      "documentationUrl": "https://www.vanterasystem.dev",
      "supportUrl": "https://www.vanterasystem.dev",
      "supportPhone": "+18005555555"
    }
  }
}
